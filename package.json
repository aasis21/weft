{
  "name": "weft",
  "version": "0.2.38",
  "private": true,
  "description": "Weft — mobile companion for GitHub Copilot CLI and local Copilot app sessions over an end-to-end encrypted relay.",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "shared",
    "extension",
    "mobile"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1"
  }
}
